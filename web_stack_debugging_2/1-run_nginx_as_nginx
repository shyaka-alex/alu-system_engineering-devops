#!/usr/bin/env bash
# Configures nginx to run as the nginx user and to listen on all IPv4 addresses on port 8080
pkill apache2
chmod 644 /etc/nginx/nginx.conf
sed -i 's/^#\?[[:space:]]*user .*/user nginx;/' /etc/nginx/nginx.conf
sed -i --follow-symlinks 's/listen \(\[::\]:\)\?80 /listen \18080 /' /etc/nginx/sites-enabled/default
sudo -u nginx service nginx restart
