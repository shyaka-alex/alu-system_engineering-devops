#!/usr/bin/env bash
# Configures nginx on a new Ubuntu server: Holberton page, 301 redirect, custom 404 page and an X-Served-By header holding the server hostname
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if [ ! -f /var/www/html/404.html ]
then
  echo "Ceci n'est pas une page" > /var/www/html/404.html
fi
cat > /etc/nginx/sites-available/default << 'CONF'
server {
    listen 80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name _;

    add_header X-Served-By $hostname always;

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
CONF
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
service nginx restart
